EVENT_SERVER_URL=http://autoqq-eventserver-api:8080
INTERNAL_API_TOKEN=replace-with-a-long-random-secret
EVENTSERVER_CONNECT_TIMEOUT_SECONDS=3
EVENTSERVER_READ_TIMEOUT_SECONDS=5
EVENTSERVER_SAFE_READ_RETRIES=1
EVENTSERVER_MAX_RESPONSE_BYTES=262144
PERMISSION_CACHE_TTL_SECONDS=30
COMMAND_RATE_LIMIT_COUNT=10
COMMAND_RATE_LIMIT_WINDOW_SECONDS=60
DELIVERY_POLL_ENABLED=true
DELIVERY_POLL_INTERVAL_SECONDS=5
DELIVERY_CLAIM_BATCH_SIZE=10
DELIVERY_LEASE_SECONDS=60
DELIVERY_WORKER_ID=replace-with-stable-instance-id
DELIVERY_EMPTY_POLL_BACKOFF_MAX_SECONDS=30
DELIVERY_SEND_TIMEOUT_SECONDS=20
DELIVERY_MAX_MESSAGE_CHARS=2000
DEFAULT_TIMEZONE=Asia/Shanghai
# Optional read-only query service (wf-data Publisher query API) for /wf style commands.
# Uncomment both lines and reuse the deployment's WFDATA_QUERY_API_TOKEN value to enable it.
#QUERY_SERVICE_URL=http://autoqq-wfdata-publisher:8081
#QUERY_SERVICE_TOKEN=replace-with-the-same-token-as-WFDATA_QUERY_API_TOKEN
QUERY_CONNECT_TIMEOUT_SECONDS=2
QUERY_READ_TIMEOUT_SECONDS=4
QUERY_MAX_RESPONSE_BYTES=65536
QUERY_CATALOG_TTL_SECONDS=300
QUERY_REPLY_MAX_CHARS=1200
